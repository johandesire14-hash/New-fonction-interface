# Configuration Firebase publique nécessaire au client — à compléter avant le build
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=

# Variables serveur/runtime uniquement. Ne jamais les préfixer par VITE_.
# À renseigner dans Netlify uniquement si les fonctions ou intégrations correspondantes sont utilisées.
