# Variables publiques injectées au build et exposées au client (VITE_*).
# À renseigner dans Netlify avant le build.
VITE_SUPABASE_URL=https://frbxlfqaovyrflqzpqsg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Domaine public du site — à compléter avant publication
SITE_URL=
